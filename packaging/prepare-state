#!/bin/sh
set -eu
cd /mnt/data/etc/wb-mqtt-dreame
test ! -L state
chown wb-dreame:wb-dreame state
chmod 0700 state
for file in state/session.json state/jobs.sqlite3 state/jobs.sqlite3-journal state/underlay-alignment.json state/mqtt-owner.json state/mqtt-legacy-preview17; do
    if [ -f "$file" ] && [ ! -L "$file" ]; then chown -h wb-dreame:wb-dreame "$file"; fi
done
for file in underlay.json underlay.jpg; do
    if [ -f "$file" ] && [ ! -L "$file" ]; then
        chown -h root:wb-dreame "$file"
        chmod 0640 "$file"
    fi
done
